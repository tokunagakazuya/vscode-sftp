      ],
      "explorer/context": [
        {
          "submenu": "filemenu/sftp",
          "group": "z_sftp",
          "when": "sftp.enabled"
        }
      ],
      "filemenu/sftp": [
        {
          "command": "sftp.edit.remote",
          "group": "1_sftp@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.revealInRemoteExplorer",
          "group": "1_sftp@2",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.copyRemotePath",
          "group": "1_sftp@3",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.copyRemoteRelativePath",
          "group": "1_sftp@4",
          "when": "sftp.enabled && !explorerResourceIsRoot"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.localToRemote",
          "group": "3_sync@1",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.remoteToLocal",
          "group": "3_sync@2",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.sync.bothDirections",
          "group": "3_sync@3",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.download.file",
          "group": "2_fileTransfer@1",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file",
          "group": "2_fileTransfer@2",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "2_fileTransfer@3",
          "when": "sftp.enabled && !explorerResourceIsRoot && !explorerResourceIsFolder"
        },
        {
          "command": "sftp.download.folder",
          "group": "2_folderTransfer@1",
          "alt": "sftp.forceDownload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.folder",
          "group": "2_folderTransfer@2",
          "alt": "sftp.forceUpload",
          "when": "sftp.enabled && explorerResourceIsFolder"
        },
        {
          "command": "sftp.upload.folder.to.allProfiles",
          "group": "2_folderTransfer@3",
          "alt": "sftp.forceUpload.to.allProfiles",
          "when": "sftp.enabled && explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "sftp.upload.file",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.upload.file.to.allProfiles",
          "group": "sftp.trans@1",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.download.file",
          "group": "sftp.trans@2",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.diff",
          "group": "3_compare",
          "when": "sftp.enabled && resourceScheme == file"
        },
        {
          "command": "sftp.remoteExplorer.editInLocal",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        }
      ],
      "editor/title/context": [
        {
          "command": "sftp.revealInExplorer",
          "group": "2_files",
          "when": "sftp.enabled && resourceScheme == remote"
        },
        {
          "command": "sftp.revealInRemoteExplorer",
          "when": "sftp.enabled && resourceScheme == file",
          "group": "2_files"
        }
      ],
      "view/item/context": [
        { "command": "sftp.openConnectInTerminal", "group": "navigation", "when": "view == remoteExplorer && viewItem == root" },
        { "command": "sftp.openConnectInTerminal", "group": "inline", "when": "view == remoteExplorer && viewItem == root" },
        { "command": "sftp.editConnection", "group": "inline", "when": "view == remoteExplorer && viewItem == root" },
        { "command": "sftp.deleteConnection", "group": "2_navigation", "when": "view == remoteExplorer && viewItem == root" },
        { "command": "sftp.editConnection", "group": "2_navigation", "when": "view == remoteExplorer && viewItem == root" },

        { "command": "sftp.remoteExplorer.refresh", "group": "1_nav@1", "when": "view == remoteExplorer && viewItem != group" },
        { "command": "sftp.create.file", "group": "1_nav@2", "when": "view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.create.folder", "group": "1_nav@2", "when": "view == remoteExplorer && viewItem == folder" },

        { "command": "sftp.remote.cut", "group": "2_clip@1", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },
        { "command": "sftp.remote.copy", "group": "2_clip@1", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },
        { "command": "sftp.remote.paste", "group": "2_clip@2", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },

        { "command": "sftp.copyRemotePath.generic", "group": "3_paths@1", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },
        { "command": "sftp.copyRemoteRelativePath.generic", "group": "3_paths@1", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },

        { "command": "sftp.remote.chmod", "group": "4_edit@1", "when": "view == remoteExplorer && viewItem != root && viewItem != group && !listMultiSelection" },
        { "command": "sftp.rename.folder", "group": "4_edit@1", "when": "view == remoteExplorer && viewItem == folder && !listMultiSelection" },
        { "command": "sftp.rename.file", "group": "4_edit@1", "when": "view == remoteExplorer && viewItem == file && !listMultiSelection" },
        { "command": "sftp.delete.remote", "group": "4_edit@2", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },

        { "command": "sftp.revealInExplorer", "group": "5_local@2", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },
        { "command": "sftp.copyLocalPath", "group": "5_local@3", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },
        { "command": "sftp.copyLocalRelativePath", "group": "5_local@3", "when": "view == remoteExplorer && viewItem != root && viewItem != group" },

        { "command": "sftp.download.folder", "group": "6_transfer@1", "alt": "sftp.forceDownload", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.download.folderAs", "group": "6_transfer@1", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder && !listMultiSelection" },
        { "command": "sftp.download.file", "group": "6_transfer@1", "when": "sftp.enabled && view == remoteExplorer && viewItem == file" },
        { "command": "sftp.download.fileAs", "group": "6_transfer@1", "when": "sftp.enabled && view == remoteExplorer && viewItem == file && !listMultiSelection" },

        { "command": "sftp.upload.folder", "group": "7_upload@1", "alt": "sftp.forceUpload", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.upload.folder.to.allProfiles", "group": "7_upload@2", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },

        { "command": "sftp.sync.localToRemote", "group": "8_sync@1", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.sync.remoteToLocal", "group": "8_sync@2", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.sync.bothDirections", "group": "8_sync@3", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },

        { "command": "sftp.remoteExplorer.editInLocal", "group": "5_local@1", "when": "view == remoteExplorer && viewItem == file && !config.sftp.downloadWhenOpenInRemoteExplorer" },
        { "command": "sftp.viewContent", "group": "5_local@1", "when": "view == remoteExplorer && viewItem == file && config.sftp.downloadWhenOpenInRemoteExplorer" },
        { "command": "sftp.diff.remoteExplorer", "group": "9_misc@2", "when": "sftp.enabled && view == remoteExplorer && viewItem == file" },

        { "command": "sftp.download.folder", "group": "inline", "when": "sftp.enabled && view == remoteExplorer && viewItem == folder" },
        { "command": "sftp.rename.folder", "group": "inline", "when": "view == remoteExplorer && viewItem == folder && !listMultiSelection" },
        { "command": "sftp.download.file", "group": "inline", "when": "view == remoteExplorer && viewItem == file" },
        { "command": "sftp.remoteExplorer.refresh", "group": "inline", "when": "view == remoteExplorer && viewItem != file && viewItem != group" },
        { "command": "sftp.remoteExplorer.connect", "group": "inline@4", "when": "view == remoteExplorer && viewItem == root" },
        { "command": "sftp.rename.file", "group": "inline", "when": "view == remoteExplorer && viewItem == file && !listMultiSelection" }
      ],
      "scm/title": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && !gitFreshRepository"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == workingTree && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "inline",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        },
        {
          "command": "sftp.upload.changedFiles",
          "group": "sftp",
          "when": "sftp.enabled && scmProvider == git && scmResourceGroup == index && !gitFreshRepository"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sftp.upload.changedFiles",
        "key": "ctrl+alt+u",
        "when": "sftp.enabled"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp.json",
        "url": "./schema/config.schema.json"
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "remote",
        "formatting": {
          "label": "${path}",
          "separator": "/"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest",
    "package": "vsce package",
    "pub:debug": "rm -rf _debug && mkdir _debug && vsce package --out _debug/sftp-debug.vsix && cd _debug && git init && git commit --allow-empty -m 'update debug package' && git checkout -b debug-pacakge && cp ../INSTALL_DEBUG.md README.md  && git add . && git commit -am 'update debug package' && git push git@github.com:Natizyskunk/vscode-sftp.git debug-pacakge --force"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^23.3.5",
    "@types/lru-cache": "^4.1.1",
    "@types/node": "^9.6.51",
    "@types/vscode": "1.64.0",
    "@types/webpack-env": "^1.13.6",
    "braces": ">=2.3.1",
    "glob-parent": ">=5.1.2",
    "jest": "^29.0.3",
    "json-schema": ">=0.4.0",
    "memfs": "^2.15.5",
    "merge": ">=2.1.1",
    "node-notifier": ">=8.0.1",
    "rimraf": "^2.7.1",
    "set-value": "^4.0.1",
    "ts-loader": "^9.4.1",
    "tslint": "^6.1.3",
    "typescript": "^3.9.7",
    "typescript-tslint-plugin": "^1.0.2",
    "webpack": "^5.0.0",
    "webpack-cli": "^4.7.0",
    "yargs-parser": "^20.2.4"
  },
  "dependencies": {
    "async": "^3.2.4",
    "fs-extra": "^10.1.0",
    "ftp": "^0.3.10",
    "ignore": "^5.1.4",
    "joi": "^10.6.0",
    "lodash.debounce": "^4.0.8",
    "lru-cache": "^4.1.3",
    "p-queue": "2.4.2",
    "ssh-config": "^1.1.3",
    "ssh2": "^1.13.0",
    "tmp": "^0.2.1",
    "upath": "^2.0.1"
  },
  "jest": {
    "verbose": true,
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "<rootDir>/test/preprocessor.js"
    },
    "testMatch": [
      "<rootDir>/test/**/*.spec.js",
      "<rootDir>/**/*/__tests__/*.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/_debug/"
    ]
  }
