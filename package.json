{
  "name": "sftp",
  "displayName": "SFTP",
  "description": "SFTP/FTP sync",
  "version": "2.0.0",
  "publisher": "tokunagakazuya",
  "author": "Natizyskunk <natan.fourie@hotmail.fr> (https://github.com/Natizyskunk)",
  "engines": {
    "vscode": "^1.64.2"
  },
  "bugs": {
    "url": "https://github.com/Natizyskunk/vscode-sftp/issues",
    "email": "natan.fourie@hotmail.fr"
  },
  "homepage": "https://github.com/Natizyskunk/vscode-sftp/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Natizyskunk/vscode-sftp.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "keywords": [
    "ftp",
    "sftp",
    "sync",
    "remote"
  ],
  "activationEvents": [
    "onCommand:sftp.config",
    "workspaceContains:.vscode/sftp.json"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension",
  "contributes": {
    "submenus": [
      {
        "id": "filemenu/sftp",
        "label": "%sftp.submenu.title%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sftp",
          "title": "%sftp.views.activityTitle%",
          "icon": "resources/remote-explorer.svg"
        }
      ]
    },
    "views": {
      "sftp": [
        {
          "id": "remoteExplorer",
          "name": "%sftp.views.remoteExplorerName%",
          "when": "sftp.enabled"
        }
      ]
    },
    "configuration": [
      {
        "type": "object",
        "title": "%sftp.config.title.1%",
        "order": 1,
        "properties": {
          "sftp.warnOnNewerRemote": {
            "type": "boolean",
            "default": true,
            "description": "%sftp.config.warnOnNewerRemote%"
          }
        }
      },
      {
        "type": "object",
        "title": "%sftp.config.title.2%",
        "order": 2,
        "properties": {
          "sftp.downloadWhenOpenInRemoteExplorer": {
            "type": "boolean",
            "default": false,
            "description": "%sftp.config.downloadWhenOpenInRemoteExplorer%"
          }
        }
      },
      {
        "type": "object",
        "title": "%sftp.config.title.3%",
        "order": 3,
        "properties": {
          "sftp.printDebugLog": {
            "type": "boolean",
            "default": false,
            "description": "%sftp.config.printDebugLog%"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "sftp.edit.remote",
        "title": "%sftp.command.editRemote%",
        "category": "SFTP"
      },
      {
        "command": "sftp.copyRemotePath",
        "title": "%sftp.command.copyRemotePath%",
        "category": "SFTP"
      },
      {
