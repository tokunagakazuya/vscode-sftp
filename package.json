        },
        {
          "command": "sftp.listActiveFolder",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.listAll",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.file",
          "when": "false"
        },
        {
          "command": "sftp.upload.changedFiles",
          "when": "sftp.enabled"
        },
        {
          "command": "sftp.upload.folder",
          "when": "false"
        },
        {
          "command": "sftp.forceUpload",
          "when": "false"
        },
